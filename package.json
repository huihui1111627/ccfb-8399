{
  "name": "equity-pierce-console",
  "version": "1.0.0",
  "private": true,
  "description": "企业股权穿透分析系统：工商数据导入、主体消歧、股权图谱、实际控制人识别与历史回看",
  "type": "module",
  "scripts": {
    "build:web": "esbuild web/src/main.ts --bundle --outfile=public/app.js --format=iife --target=es2020 --sourcemap",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:web && npm run build:server",
    "dev": "npm run build:web && tsx watch src/server.ts",
    "start": "npm run build && node dist/server.js",
    "dataset": "tsx scripts/generate-dataset.ts",
    "ground-truth": "python3 tools/build_ground_truth.py",
    "test": "node --import tsx --test tests/*.test.ts",
    "verify": "npm run dataset && npm run ground-truth && npm test"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
